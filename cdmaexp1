EXP1 Python
# EXPERIMENT 01 : CDMA FUNCTION CODE

# Fixed input data
d1 = [1, 0, 1, 1]
d2 = [0, 1, 0, 1]

# Fixed orthogonal codes
c1 = [1, 1, 1, 1]
c2 = [1, -1, 1, -1]

print("User 1 Code:", c1)
print("User 2 Code:", c2)

# Convert data
for i in range(4):
    if d1[i] == 0:
        d1[i] = -1

    if d2[i] == 0:
        d2[i] = -1

print("\nConverted Data:")
print("User 1:", d1)
print("User 2:", d2)

# Encoding
e1 = []
e2 = []

for i in range(4):

    temp1 = []
    temp2 = []

    for j in range(4):

        temp1.append(d1[i] * c1[j])
        temp2.append(d2[i] * c2[j])

    e1.append(temp1)
    e2.append(temp2)

print("\nEncoded Signals:")
print("User 1 Encoded:", e1)
print("User 2 Encoded:", e2)

# Transmission
transmitted = []

for i in range(4):

    temp = []

    for j in range(4):

        temp.append(e1[i][j] + e2[i][j])

    transmitted.append(temp)

print("\nTransmitted Signal:")
print(transmitted)

# Decoding User 1
decoded1 = []

for i in range(4):

    s = 0

    for j in range(4):

        s += transmitted[i][j] * c1[j]

    decoded1.append(s)

# Decoding User 2
decoded2 = []

for i in range(4):

    s = 0

    for j in range(4):

        s += transmitted[i][j] * c2[j]

    decoded2.append(s)

print("\nDecoded Values User 1:", decoded1)
print("Decoded Values User 2:", decoded2)

print("\nFinal Output:")

print("User 1 Data:")
for i in decoded1:
    if i > 0:
        print(1, end=" ")
    else:
        print(0, end=" ")

print("\nUser 2 Data:")
for i in decoded2:
    if i > 0:
        print(1, end=" ")
    else:
        print(0, end=" ")
